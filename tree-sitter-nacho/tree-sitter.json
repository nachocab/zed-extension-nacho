{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "nacho",
      "camelcase": "Nacho",
      "scope": "source.nacho",
      "path": ".",
      "file-types": ["txt"],
      "highlights": "../languages/nacho/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.2.0",
    "license": "MIT",
    "description": "Nacho, a variation of Markdown for note-taking",
    "authors": [{ "name": "Nacho Caballero" }],
    "links": { "repository": "https://github.com/nachocab/zed-extension-nacho" }
  }
}
